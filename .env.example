# ==============================================================================
# Variáveis de Ambiente de Produção — FinanSmart Pro (finansmart.tccodes.com.br)
# Copie este arquivo para .env no servidor e defina senhas seguras exclusivas
# ==============================================================================

POSTGRES_USER=finan_admin
POSTGRES_PASSWORD=substitua_por_uma_senha_forte_do_postgres
POSTGRES_DB=finansmart_prod

# Conexão interna entre os contêineres Docker (rede internal segura)
DATABASE_URL=postgresql://finan_admin:substitua_por_uma_senha_forte_do_postgres@db:5432/finansmart_prod

# Chave secreta criptográfica de alta entropia para cookies HttpOnly (64 caracteres)
# Dica de geração segura: openssl rand -hex 32
SESSION_SECRET=substitua_por_uma_chave_aleatoria_de_64_chars_hexadecimal

PORT=3001
NODE_ENV=production
HOST=0.0.0.0
CORS_ORIGIN=https://finansmart.tccodes.com.br

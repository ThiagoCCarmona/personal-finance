{
  "name": "sistema-financeiro-backend",
  "version": "1.0.0",
  "description": "Backend do Sistema de Gestão Financeira Pessoal (Self-Hosted)",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
